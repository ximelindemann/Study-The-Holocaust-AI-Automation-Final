      "position": [
        448,
        208
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let t = $json.pageText || \"\";\n// Remove base64 data URIs (embedded images) entirely\nt = t.replace(/data:[^;]+;base64,[A-Za-z0-9+/=]+/g, \" \" );\n// Remove any remaining long runs of base64-like noise\nt = t.replace(/[A-Za-z0-9+/]{80,}={0,2}/g, \" \" );\n// Collapse whitespace\nt = t.replace(/\\s+/g, \" \" ).trim();\nreturn { json: { pageText: t } };"
      },
      "id": "e2098147-b6c9-4e92-a7ed-2c924647b779",
